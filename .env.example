http://localhost:3000# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g., postgresql://username:password@hostname:5432/dbname)
DATABASE_URL=

# JWT_SECRET: Private key used to sign and verify real JWT tokens for authentication
JWT_SECRET=

# SUPABASE_URL: URL of your Supabase project instance
SUPABASE_URL=

# SUPABASE_PUBLISHABLE_KEY: Supabase Anon/Publishable Public Key
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SECRET_KEY: Supabase Service Role Secret Key
SUPABASE_SECRET_KEY=

# SUPABASE_JWKS_URL: JWKS URL for Supabase Auth
SUPABASE_JWKS_URL=
